# ベース地図プロバイダ設定（サービス提供者がデプロイ時に設定）。
# 実値は .env.local に置く（.env.local は gitignore 済み。VITE_ プレフィックスはクライアントへ露出する）。
#
# 詳細: docs/wants/03_地図機能.md「地図プロバイダ（背景タイル）」

# 使用する背景タイル: gsi（既定・無料・キー不要）| google
VITE_MAP_PROVIDER=gsi

# Google Maps JavaScript API キー（VITE_MAP_PROVIDER=google のとき必須）。
# ブラウザキーとして露出するため、Google Cloud 側で HTTP リファラ制限
# ＋ API を Maps JavaScript API のみに制限 ＋ 予算上限を設定すること。
# 取得: https://developers.google.com/maps/documentation/javascript/get-api-key
VITE_GOOGLE_MAPS_API_KEY=

# LinkSelf バックエンドの有効化（ScopeDevice 先行スライス、省略時 = 無効）。
# 1/true/on で個人設定を LinkSelf MyDB の SQL 面（ブラウザは OPFS SQLite）に永続する。
# 未設定・その他の値では従来どおり localStorage 永続を使う。
# ※メンバー間共有（ScopeNetwork）は link-self Phase C 待ちのため本フラグでは切替らない。
# 詳細: docs/wants/01_共通基盤.md「同期スコープ」
# VITE_LINKSELF=1

# 端末ペアリング QR/URL のベース URL（省略可）。
# 省略時は実行時オリジン（window.location.origin + BASE_URL）を用いる＝本番は自動で正しい。
# スマホから読み取れない localhost 開発時や、プロキシ/独自ドメイン背後で正規 URL に固定したい
# ときだけ設定する。例: https://app.example.com/
# 詳細: docs/wants/01_共通基盤.md「端末ペアリング」
VITE_PAIRING_BASE_URL=
