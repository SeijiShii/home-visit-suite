#!/bin/sh
# コミット前チェック（CODEMAP 索引 + 操作マニュアルの陳腐化）
#   docs/CODEMAP.md   = 仕様テーマ↔実装ファイルの対応索引（維持ルールは CLAUDE.md 開発方針）
#   docs/manual/      = 操作マニュアル本文（docs/wants/12_操作マニュアル.md）
#
# 緊急回避: git commit --no-verify

is_target='\.(ts|tsx)$'
not_test='\.test\.(ts|tsx)$'

# ---------------------------------------------------------------- マニュアル
# マニュアルの frontmatter `sources` に載っているファイルを変更したら、
# 該当ページが古くなり得るので指摘する（非ブロック。本文が実際に古くなったかは
# 機械判定できないため、「見に行く先」を示すところまでを機械の仕事にする）。
manual_staged=$(git diff --cached --name-only --diff-filter=ACMR || true)
if [ -n "$manual_staged" ] && [ -f pwa/scripts/manual/check.mjs ]; then
  # shellcheck disable=SC2086
  impact=$(node pwa/scripts/manual/check.mjs --impact $manual_staged 2>&1)
  if [ -n "$impact" ]; then
    echo "ⓘ マニュアル確認: 変更したファイルを参照している操作マニュアルがあります。" >&2
    echo "$impact" >&2
    echo "  更新する場合: /manual-sync → npm run manual:seal（不要ならこのまま OK）" >&2
  fi
fi

# ------------------------------------------------------------------ CODEMAP
structural=$(git diff --cached --name-only --diff-filter=ADR -- pwa/src \
  | grep -E "$is_target" | grep -vE "$not_test" || true)

modified=$(git diff --cached --name-only --diff-filter=M -- pwa/src \
  | grep -E "$is_target" | grep -vE "$not_test" || true)

# CODEMAP がステージ済みなら両方 OK
if git diff --cached --name-only -- docs/CODEMAP.md | grep -q 'docs/CODEMAP.md'; then
  exit 0
fi

# [1] 構造変更 → ブロック
if [ -n "$structural" ]; then
  echo "✖ CODEMAP 未更新: pwa/src の .ts(x) が増減/リネームされていますが docs/CODEMAP.md がステージされていません。" >&2
  echo "" >&2
  echo "対象:" >&2
  echo "$structural" | sed 's/^/  - /' >&2
  echo "" >&2
  echo "docs/CODEMAP.md に該当行を追加/削除してからコミットしてください。" >&2
  echo "意図的にスキップ: git commit --no-verify" >&2
  exit 1
fi

# [2] 修正のみ → リマインド（非ブロック）
if [ -n "$modified" ]; then
  echo "ⓘ CODEMAP 確認: pwa/src の .ts(x) を修正しています。責務が変わったなら docs/CODEMAP.md の該当行も直してください（不変ならこのまま OK）。" >&2
fi

exit 0
